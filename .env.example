ENVIRONMENT=local
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
POSTGRES_USER=commerce
POSTGRES_PASSWORD=commerce_dev_only
POSTGRES_DB=commerce
DATABASE_URL=postgresql+asyncpg://commerce:commerce_dev_only@postgres:5432/commerce
REDIS_URL=redis://redis:6379/0
READINESS_TIMEOUT_SECONDS=2.0
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
LLM_PROVIDER=openai
LLM_DEFAULT_MODEL=gpt-5.6-sol
# Optional OpenAI-compatible model gateway (for example LiteLLM routing to Claude/Gemini/local models)
LLM_GATEWAY_BASE_URL=
LLM_GATEWAY_API_KEY=
LLM_FALLBACK_PROVIDER=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_RUN_BUDGET_USD=1.0
# Required only when saving API credentials from the admin settings screen (32+ random chars)
SETTINGS_MASTER_KEY=
ALLOW_MARKETING_DRAFT_BEFORE_APPROVAL=false
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-07
NAVER_API_HUB_CLIENT_ID=
NAVER_API_HUB_CLIENT_SECRET=
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=
NAVER_SEARCH_AD_API_KEY=
NAVER_SEARCH_AD_SECRET_KEY=
NAVER_SEARCH_AD_CUSTOMER_ID=
NAVER_API_HUB_BASE_URL=https://naverapihub.apigw.ntruss.com
